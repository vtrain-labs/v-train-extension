{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.0.2",
  "description": "__MSG_extDesc__",
  "homepage_url": "https://github.com/vtrain-labs/v-train-extension",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "contextMenus",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "incognito": "spanning",
  "action": {
    "default_popup": "popup.html",
    "default_title": "V-Train Control Panel",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
