{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.0",
  "description": "__MSG_extDesc__",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "incognito": "spanning",
  "action": {
    "default_popup": "popup.html",
    "default_title": "V-Train Control Panel",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
